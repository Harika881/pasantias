# FILE: .env.example (LLM section replaced)

# --- LLM Provider (FREE-TIER FIRST) ---
# auto = try Groq -> Gemini -> Ollama -> OpenAI -> Mock, in that order, based on
# whichever keys/services are available. You can also force one explicitly.
LLM_PROVIDER=auto              # auto | groq | gemini | ollama | openai | mock

# Option 1 (recommended free option): Groq Cloud — https://console.groq.com/keys
# Free tier, no credit card required, hosts Llama 3.3 70B at very high speed.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Option 2 (free alternative): Google AI Studio — https://aistudio.google.com/apikey
# Free tier, no credit card required, Gemini 2.0 Flash.
GEMINI_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Option 3 (fully local & free forever, no API key, no internet required):
# Install Ollama from https://ollama.com then run:  ollama pull llama3.1:8b
# (or `ollama pull qwen2.5:14b` for noticeably better quality if you have ~16GB RAM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Option 4 (paid, optional, only used if LLM_PROVIDER=openai or others are unset):
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini